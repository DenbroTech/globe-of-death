{
  "appId": "com.globeofdeath.game",
  "appName": "Globe of Death",
  "webDir": "dist",
  "backgroundColor": "#07060a",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#07060a",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "android": {
    "backgroundColor": "#07060a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#07060a",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
